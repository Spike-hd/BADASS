# This file tells FRR which routing daemons must be started.
# Only the daemons required by the subject are enabled.

# Zebra manages the Linux routing table and interfaces.
zebra=yes

# BGP daemon, required for BGP and later EVPN.
bgpd=yes

# OSPF daemon, required by the subject.
ospfd=yes

# IS-IS daemon, required by the subject.
isisd=yes

# Other FRR daemons are not required for Part 1.
ospf6d=no
ripd=no
ripngd=no
pimd=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
staticd=no
pbrd=no
bfdd=no
fabricd=no

# Enable integrated configuration loading through vtysh.
vtysh_enable=yes

# Daemon options.
# --daemon means the daemon runs in background.
# -A 127.0.0.1 means the daemon only accepts local vty connections.
# Only local commands inside the container can control the daemon.
zebra_options=" -s 90000000 --daemon -A 127.0.0.1"
bgpd_options="   --daemon -A 127.0.0.1"
ospfd_options="  --daemon -A 127.0.0.1"
isisd_options="  --daemon -A 127.0.0.1"

ospf6d_options=" --daemon -A ::1"
ripd_options="   --daemon -A 127.0.0.1"
ripngd_options=" --daemon -A ::1"
pimd_options="   --daemon -A 127.0.0.1"
ldpd_options="   --daemon -A 127.0.0.1"
nhrpd_options="  --daemon -A 127.0.0.1"
eigrpd_options=" --daemon -A 127.0.0.1"
babeld_options=" --daemon -A 127.0.0.1"
sharpd_options=" --daemon -A 127.0.0.1"
staticd_options="--daemon -A 127.0.0.1"
pbrd_options="   --daemon -A 127.0.0.1"
bfdd_options="   --daemon -A 127.0.0.1"
fabricd_options="--daemon -A 127.0.0.1"

# Optional limits and debugging options.
# Keep them commented unless needed.
#MAX_FDS=1024
#watchfrr_options=""
